{
  "name": "randomwordbot",
  "version": "1.2.0",
  "private": true,
  "description": "RandomWordBot for Discord",
  "keywords": [
    "random",
    "word",
    "bot",
    "discord"
  ],
  "homepage": "https://github.com/chump29/randomwordbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/randomwordbot.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "clean": "rimraf node_modules bun.lock .vscode coverage",
    "clean:coverage": "rimraf coverage",
    "clean:db": "rimraf db/randomwordbot.db",
    "dev": "bun --watch run index.ts",
    "preinstall": "bunx only-allow bun",
    "postinstall": "config-init",
    "lint": "bun run lint:biome && bun run lint:env",
    "lint:biome": "biome check --write --verbose",
    "lint:ci": "biome ci --verbose --reporter=default --reporter=github",
    "lint:env": "dotenv-linter check .",
    "prepare": "husky",
    "prod": "bun run index.ts",
    "test": "bun run clean:coverage && bun test --coverage --isolate --coverage-reporter=text --coverage-reporter=lcov"
  },
  "lint-staged": {
    "*.{json,ts}": "biome ci --no-errors-on-unmatched",
    ".env*": "dotenv-linter check"
  },
  "overrides": {
    "drizzle-orm": "1.0.0-rc.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@postfmly/checkrate": "^1.0.3",
    "@postfmly/logger": "^1.0.3",
    "@postfmly/logoserver": "^1.0.6",
    "discord.js": "^14.26.4",
    "drizzle-orm": "1.0.0-rc.2",
    "pluralize": "^8.0.0",
    "random-words": "^2.0.1"
  },
  "devDependencies": {
    "@nano-faker/patterns": "^1.0.1",
    "@nano-faker/person": "^1.0.1",
    "@postfmly/config": "^1.2.16",
    "@types/pluralize": "^0.0.33",
    "drizzle-query-logger": "^1.1.2",
    "drizzle-seed": "1.0.0-rc.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest-mock": "^30.4.1",
    "lint-staged": "^17.0.4",
    "rimraf": "^6.1.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "~1.3.13"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "pluralize@8.0.0": "patches/pluralize@8.0.0.patch"
  }
}
